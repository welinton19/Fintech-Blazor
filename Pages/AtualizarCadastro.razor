@page "/atualizar-cadastro"
@layout MainLayout
@inject IAuthService AuthService
@inject NavigationManager Navigation


<div style="margin-top:50px; min-height: 100vh; background: linear-gradient(135deg, #1a1a2e, #16213e, #0f3460); display: flex; align-items: center; justify-content: center; padding: 20px;">
	<MudPaper Elevation="10" Class="pa-10 rounded-xl" Style="width:100%; max-width:420px; background: rgba(255,255,255,0.05); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.1);">
		@*Header*@
		<MudStack AlignItems="AlignItems.Center" Class="mb-8">
			<MudIcon Icon="@Icons.Material.Filled.Face"
					 Style="font-size: 3rem; color: #00d4ff" />
			<MudText Typo="Typo.h4" Style="color: white; font-weight: 700;">
				Fintech
			</MudText>
			<MudText Typo="Typo.body2" Style="color: rgba(255,255,255,0.5);">
				Atualizar Cadastro
			</MudText>
		</MudStack>

		@* Alerta de erro *@
		@if (!string.IsNullOrEmpty(errorMessage))
		{
			<MudAlert Severity="Severity.Error" Class="mb-4" Dense="true">
				@errorMessage
			</MudAlert>
		}

		@*Fomulario*@
		<MudStack Spacing="4">
			<MudTextField @bind-Value="atualizarCadastroRequest.Name"
						  Label="Name"
						  Variant="Variant.Outlined"
						  InputType="InputType.Text"
						  Adornment="Adornment.Start"
						  Style="color:white;"
						  FullWidth="true" />
			
			<MudTextField @bind-Value="atualizarCadastroRequest.Email"
						  Label="E-mail"
						  Variant="Variant.Outlined"
						  InputType="InputType.Email"
						  Adornment="Adornment.Start"
						  Style="color:white;"
						  FullWidth="true" />
			
			<MudTextField @bind-Value="atualizarCadastroRequest.Cidade"
						  Label="Cidade"
						  Variant="Variant.Outlined"
						  InputType="InputType.Text"
						  Adornment="Adornment.Start"
						  Style="color:white;" 
						  FullWidth="true" />
			<MudTextField @bind-Value="atualizarCadastroRequest.Cep"
						  Label="CEP"
						  Variant="Variant.Outlined"
						  InputType="InputType.Text"
						  Adornment="Adornment.Start"
						  Style="color:white;"
						  FullWidth="true" />
			<MudTextField @bind-Value="atualizarCadastroRequest.Logradouro"
						  Label="Logradouro"
						  Variant="Variant.Outlined"
						  InputType="InputType.Text"
						  Adornment="Adornment.Start"
						  Style="color:white;"
						  FullWidth="true" />
			<MudTextField @bind-Value="atualizarCadastroRequest.Estado"
						  Label="Estado"
						  Variant="Variant.Outlined"
						  InputType="InputType.Text"
						  Adornment="Adornment.Start"
						  Style="color:white;"
						  FullWidth="true" />
			
			

			<MudButton Variant="Variant.Filled"
					   Color="MudBlazor.Color.Info"
					   FullWidth="true"
					   Size="MudBlazor.Size.Large"
					   OnClick="HandleAtualizarCadastro"
					   Disabled="@isLoading"
					   Class="mt-2"
					   Style="background: linear-gradient(90deg, #00d4ff, #0099cc); font-weight: 700;">
				@if (isLoading)
				{
					<MudProgressCircular Size="MudBlazor.Size.Small" Indeterminate="true" Class="mr-2" />
					<span>Entrando...</span>
				}
				else
				{
					<span>Cadastrar</span>
				}
			</MudButton>


		</MudStack>


	</MudPaper>
</div>

@code {
	private AtualizarCadastroRequest atualizarCadastroRequest = new();
	private string errorMessage = string.Empty;
	private bool isLoading = false;

	

	private async Task HandleAtualizarCadastro()
	{
		isLoading = true;
		errorMessage = string.Empty;

		try
		{
			// ✅ Valida campos obrigatórios
			if (string.IsNullOrEmpty(atualizarCadastroRequest.Name) ||
				string.IsNullOrEmpty(atualizarCadastroRequest.Email) ||
				string.IsNullOrEmpty(atualizarCadastroRequest.Cidade) ||
				string.IsNullOrEmpty(atualizarCadastroRequest.Cep) ||
				string.IsNullOrEmpty(atualizarCadastroRequest.Logradouro) ||
				string.IsNullOrEmpty(atualizarCadastroRequest.Estado))
			{
				errorMessage = "Preencha todos os campos obrigatórios.";
				return;
			}

			

			var sucesso = await AuthService.AtualizarCadastroAsync(atualizarCadastroRequest);

			if (sucesso != null	)
				Navigation.NavigateTo("/login");
			else
				errorMessage = "Erro ao realizar atualização. Tente novamente.";
		}
		catch (Exception)
		{
			errorMessage = "Erro ao conectar com o servidor.";
		}
		finally
		{
			isLoading = false;
		}
	}
}

